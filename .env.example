# Copiar a .env y completar. run.sh lo carga automáticamente.
ANTHROPIC_API_KEY=
PORTAL_COMPANY_NAME=Nuestra Empresa
# Clave para firmar sesiones (si se omite se genera una en data/secret_key)
PORTAL_SECRET_KEY=
# 1 si el portal se sirve detrás de HTTPS (cookies seguras)
PORTAL_HTTPS=0
# Opcionales
# PORTAL_AI_MODEL=claude-opus-5-5
# PORTAL_AI_EFFORT=low
# Contraseñas iniciales de los usuarios de ejemplo (solo se usan al crear la base).
# Si se dejan vacías se generan al azar en data/credenciales_iniciales.txt
PORTAL_ADMIN_PASSWORD=
PORTAL_PROVIDER_PASSWORD=
PORTAL_AGENT_PASSWORD=
